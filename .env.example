# Copy this file to .env and replace the password before running.
# Never commit .env to git.
FOLIOSENTRY_DB_PASSWORD=
FOLIOSENTRY_BACKEND_PORT=18901
FOLIOSENTRY_FRONTEND_PORT=18902

# Login cookie requires HTTPS by default. For local loopback preview ONLY, set
# AUTH_COOKIE_SECURE=false and ALLOW_HTTP_DEV=true in the private .env file.
# Never enable HTTP login on LAN or a public network.
FOLIOSENTRY_AUTH_ALLOWED_ORIGINS=
FOLIOSENTRY_AUTH_COOKIE_SECURE=true
FOLIOSENTRY_ALLOW_HTTP_DEV=false
